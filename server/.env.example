# MFLUX / Qwen-Image 2.1 is now the default. No ComfyUI or Ollama is required.
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
IMAGE_PROVIDER=mflux
PROMPT_REFINEMENT=none
MFLUX_BINARY=~/.local/bin/mflux-generate-qwen-2.1
OUTPUT_DIRECTORY=~/Desktop
MFLUX_TIMEOUT_MS=1800000
MAX_CONCURRENT_GENERATIONS=1
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STEPS=40
# Optional: set HF_HUB_CACHE to the same path used by the download script.
# MFLUX jobs run offline and will not start another model download.

# Legacy providers (only used when explicitly enabled):
# IMAGE_PROVIDER=stable-diffusion
# PROMPT_REFINEMENT=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=120000
IMAGE_API_URL=http://127.0.0.1:7860
IMAGE_API_USERNAME=
IMAGE_API_PASSWORD=
IMAGE_TIMEOUT_MS=180000
