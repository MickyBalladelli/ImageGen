# Copy this file to server/.env. No paid service or API key is required.
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
# AUTOMATIC1111-compatible Stable Diffusion server started with --api
IMAGE_API_URL=http://127.0.0.1:7860
# Optional HTTP Basic credentials if the image server uses --api-auth
IMAGE_API_USERNAME=
IMAGE_API_PASSWORD=
OLLAMA_TIMEOUT_MS=120000
IMAGE_TIMEOUT_MS=180000
MAX_CONCURRENT_GENERATIONS=1
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
IMAGE_STEPS=25
